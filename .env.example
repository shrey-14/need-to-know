# LLM (Groq free tier — https://console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

HF_TOKEN=

# Auth
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60


# Vector store
CHROMA_PERSIST_DIR=./.chroma
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5

# Monitoring (LangSmith — optional, free tier)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=rag-chatbot-rbac

# Cost/token logging — Supabase project settings -> Database -> Connection string
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@[YOUR-PROJECT-REF].supabase.co:5432/postgres
DAILY_COST_ALERT_USD=1.0

# Slack incoming webhook (api.slack.com/apps -> your app -> Incoming Webhooks)
SLACK_WEBHOOK_URL=

# Frontend (Vite)
# /api is proxied to the backend and rewritten (see frontend/vite.config.ts) —
# required so API calls don't collide with the frontend's own /login, /chat
# page routes. Set to a full backend origin for other deploys.
VITE_API_BASE_URL=/api

# LLM (Groq free tier — https://console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

HF_TOKEN=

# Auth
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60


# Vector store
CHROMA_PERSIST_DIR=./.chroma
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5

# Monitoring (LangSmith — optional, free tier)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=rag-chatbot-rbac

# Cost/token logging — Supabase project settings -> Database -> Connection string
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@[YOUR-PROJECT-REF].supabase.co:5432/postgres
DAILY_COST_ALERT_USD=1.0

# Cost-alert email (SMTP, STARTTLS on 587). Any provider works:
#   Gmail: SMTP_HOST=smtp.gmail.com, SMTP_USERNAME=you@gmail.com,
#          SMTP_PASSWORD=<16-char app password from myaccount.google.com/apppasswords;
#          needs 2-Step Verification on>. Never your normal Gmail password.
#   Or a transactional provider / Azure Communication Services: use its SMTP host + credentials.
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Frontend (Vite)
# /api is proxied to the backend and rewritten (see frontend/vite.config.ts) —
# required so API calls don't collide with the frontend's own /login, /chat
# page routes. Set to a full backend origin for other deploys.
VITE_API_BASE_URL=/api

# Production only: the frontend's URL (Azure Static Web Apps), comma-separated
# if more than one. Leave empty locally; Vite's dev proxy avoids CORS.
CORS_ORIGINS=
